{
  "name": "admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:login-css && tsc -p . && vite build",
    "build:login-css": "tailwindcss --input src/login.css --output ../internal/access/static/login.css --minify",
    "dev:login-css": "tailwindcss --input src/login.css --output ../internal/access/static/login.css --watch",
    "typecheck": "tsc -p .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-web": "^2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
